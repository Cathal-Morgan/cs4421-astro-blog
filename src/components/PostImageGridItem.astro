---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	image: ImageMetadata | string;
	description?: string;
	showDescription?: boolean;
	main?: boolean;
}

const { image, description, showDescription = true, main = false } = Astro.props;
---

<div
	class:list={['image-grid__photo', { 'image-grid__photo--main': main }]}
	tabindex={description && showDescription ? 0 : undefined}
	aria-label={description}
>
	{typeof image === 'string' ? (
		<img src={image} alt={description ?? ''} loading={main ? undefined : 'lazy'} />
	) : (
		<Image src={image} alt={description ?? ''} />
	)}
	{description && showDescription && <div class="image-grid__caption">{description}</div>}
</div>

<style>
	.image-grid__photo {
		position: relative;
		width: 100%;
		height: 100%;
	}

	.image-grid__photo--main {
		height: auto;
	}

	.image-grid__photo--main :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}

	.image-grid__caption {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		padding: 0.5rem 0.75rem;
		background: rgb(0 0 0 / 75%);
		color: white;
		font-size: 0.8rem;
		line-height: 1.3;
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.image-grid__photo:hover .image-grid__caption,
	.image-grid__photo:focus .image-grid__caption {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.image-grid__caption {
			transition: none;
		}
	}
</style>
