---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = {
	author: CollectionEntry<'authors'>['data'];
};

const { author } = Astro.props;
---

<section class="author-bio" aria-labelledby="author-heading">
	<Image class="avatar" src={author.avatar} width={96} height={96} alt={`${author.name}'s profile picture`} />
	<div class="author-details">
		<p class="eyebrow">About the author</p>
		<h2 id="author-heading">{author.name}</h2>
		<p>{author.bio}</p>
		<nav aria-label={`${author.name}'s social links`}>
			<ul>
				{author.socialLinks.map((link) => (
					<li><a href={link.url} rel="me">{link.label}</a></li>
				))}
			</ul>
		</nav>
	</div>
</section>

<style>
	.author-bio {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.avatar {
		flex: 0 0 96px;
		width: 96px;
		height: 96px;
		object-fit: cover;
		border-radius: 50%;
	}
	.author-details {
		flex: 1;
	}
	.eyebrow {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.75em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h2 {
		margin: 0.1rem 0 0.5rem;
		font-size: 1.5em;
	}
	.author-details > p:not(.eyebrow) {
		margin: 0 0 0.75rem;
	}
	ul {
		display: flex;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.9em;
	}
	@media (max-width: 520px) {
		.author-bio {
			gap: 1rem;
		}
		.avatar {
			flex-basis: 72px;
			width: 72px;
			height: 72px;
		}
	}
</style>
