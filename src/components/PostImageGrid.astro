---
import type { ImageMetadata } from 'astro';
import PostImageGridItem from './PostImageGridItem.astro';

type GalleryImage = ImageMetadata | string | { src: ImageMetadata | string; description: string };
interface Props {
	images: GalleryImage[];
	showDescriptions?: boolean;
}

const { images, showDescriptions = true } = Astro.props;
const additionalImages = images.slice(1);
const isDescribedImage = (
	image: GalleryImage,
): image is { src: ImageMetadata | string; description: string } =>
	typeof image === 'object' && 'description' in image;
const getSource = (image: Props['images'][number]) =>
	isDescribedImage(image) ? image.src : image;
const getDescription = (image: Props['images'][number]) =>
	isDescribedImage(image) ? image.description : undefined;
const firstSource = images.length > 1 ? getSource(images[1]) : undefined;
const widgetAspectRatio = !firstSource || typeof firstSource === 'string'
	? 2
	: firstSource.width / firstSource.height;
const gridColumns =
	additionalImages.length > 0
		? Math.min(
				additionalImages.length,
				Math.max(
					Math.ceil(Math.sqrt(additionalImages.length)),
					Math.ceil(Math.sqrt(additionalImages.length * widgetAspectRatio)),
				),
			)
		: 1;
const gridRows = Math.ceil(additionalImages.length / gridColumns);
const gridWidth = Math.min(96, (88 * gridColumns) / (gridRows * widgetAspectRatio));
---

{images.length > 0 && (
	<div class="image-grid" role="group" aria-label="Post images">
		<div
			class="image-grid__main"
		>
			<PostImageGridItem
				image={getSource(images[0])}
				description={getDescription(images[0])}
				showDescription={showDescriptions}
				main
			/>
		</div>
		{additionalImages.length > 0 && (
			<div
				class="image-grid__additional"
				style={`--grid-columns: ${gridColumns}; --grid-width: ${gridWidth}%`}
			>
				{additionalImages.map((image) => (
					<div class="image-grid__item">
						<PostImageGridItem
							image={getSource(image)}
							description={getDescription(image)}
							showDescription={showDescriptions}
						/>
					</div>
				))}
			</div>
		)}
	</div>
)}

<style>
	.image-grid {
		position: relative;
		width: 100%;
	}

	.image-grid__additional {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
		gap: 0.75rem;
		width: var(--grid-width);
		transform: translate(-50%, -50%);
	}

	.image-grid__item {
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: 8px;
		box-shadow: var(--box-shadow);
	}

	.image-grid__item :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

</style>
